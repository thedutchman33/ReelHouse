# Kotlin music backend. Keep this file server-side only.
PORT=8080
REELHOUSE_APP_URL=http://localhost:3000
REELHOUSE_ALLOWED_ORIGINS=http://localhost:3000
MUSIC_BACKEND_PUBLIC_URL=http://localhost:8080

# Supabase (service role is required for Spotify token tables and imports)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify Developer Dashboard → your app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8080/v1/spotify/callback
SPOTIFY_CONNECT_REDIRECT_PATH=/music?spotify=connected

# 32 random bytes, base64: openssl rand -base64 32
MUSIC_TOKEN_ENCRYPTION_KEY=

# Optional registered LRCLIB credentials
LRCLIB_USER_AGENT=ReelhouseMusic/1.0 (https://reelhouse.app; music@reelhouse.app)
LRCLIB_APP_ID=
LRCLIB_API_KEY=
BETTERLYRICS_API_KEY=
MUSICBRAINZ_USER_AGENT=ReelhouseMusic/1.0 (https://reelhouse.app; music@reelhouse.app)

# ZIP import limits
MUSIC_MAX_IMPORT_BYTES=104857600
MUSIC_MAX_IMPORT_UNCOMPRESSED_BYTES=419430400
MUSIC_MAX_JSON_ENTRY_BYTES=50331648
MUSIC_MAX_IMPORT_ENTRIES=20000
